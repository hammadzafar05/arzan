# `npm run dev` copies this to .dev.vars and fills in BETTER_AUTH_SECRET for local development.
# In production set these as secrets:
#   npx wrangler secret put BETTER_AUTH_SECRET
# Required: a random string of at least 32 characters (e.g. `openssl rand -hex 32`).
BETTER_AUTH_SECRET=
# Optional: send real emails through Resend (free tier). Without it, emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM="Arzan <onboarding@resend.dev>"
